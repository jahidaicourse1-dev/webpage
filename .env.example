# APP_URL: Public base URL of the deployed application (used for SEO canonical links, sitemap, and OpenGraph tags)
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Optional public backend API origin when hosting the frontend statically (e.g. GitHub Pages)
VITE_API_BASE_URL=""

# CORS_ORIGIN: Optional comma-separated allowed frontend origins when API is hosted separately from GitHub Pages
CORS_ORIGIN=""

# ADMIN_USERNAME: Private administrator username (never expose in VITE_ variables)
ADMIN_USERNAME="your_admin_username"

# ADMIN_PASSWORD_HASH: Bcrypt hash of the administrator password.
# Generate with: npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH="\$2b\$12\$replace_with_real_bcrypt_hash"

# SESSION_SECRET: Random 64-char hex secret for signing httpOnly admin session cookies
SESSION_SECRET="replace_with_a_long_random_hex_secret"

# Optional SMTP configuration for server-side contact form email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
ADMIN_NOTIFY_EMAIL=""
